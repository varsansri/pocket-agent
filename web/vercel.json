{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/hb.js",
      "destination": "https://hanubees-commerce.vercel.app/hb.js"
    },
    {
      "source": "/api/hb",
      "destination": "https://hanubees-commerce.vercel.app/api/hb"
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/varsansri/pocket-agent/releases/download/android-v1.0/PocketAgent.apk",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path((?!admin|api/|download|privacy|index|[^/]+\\.(?:txt|xml|svg|png|js|ico|json)$).+)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?hanubees\\.com"
        }
      ],
      "destination": "https://ridkey.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}